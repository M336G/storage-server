{
  "name": "storage-server",
  "description": "An easy to setup and optimized storing solution using Bun.",
  "version": "1.7.2",
  "main": "app.js",
  "author": "M336",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "bun app.js --smol --max-executable-size=192 --max-old-space-size=256 --max-semi-space-size=2",
    "dev": "bun --watch --dev app.js --smol --max-executable-size=192 --max-old-space-size=256 --max-semi-space-size=2",
    "watch": "bun --watch app.js --smol --max-executable-size=192 --max-old-space-size=256 --max-semi-space-size=2"
  },
  "dependencies": {
    "file-type": "^21.0.0",
    "validator": "^13.15.15"
  }
}
